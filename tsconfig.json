{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "allowImportingTsExtensions": true,
    "strict": true, "noEmit": true, "skipLibCheck": true, "erasableSyntaxOnly": true,
    "noUnusedLocals": true, "noUnusedParameters": true, "verbatimModuleSyntax": true
  },
  "include": ["src"]
}
